<Window x:Class="MediCoreHospital.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediCore | نظام إدارة المستشفى" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="268"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource NavyBrush}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MediCore" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="نظام إدارة المستشفى" Foreground="#B9D9F5" Margin="0,3,0,28"/>
                    <TextBlock Text="التشغيل الطبي" Foreground="#72D6D1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="لوحة التحكم" Tag="Dashboard" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="المرضى" Tag="Patients" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="الأطباء والأقسام" Tag="Clinical" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="المواعيد والاستقبال" Tag="Appointments" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="التنويم والأسرة" Tag="Inpatient" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <TextBlock Text="الإدارة المالية" Foreground="#72D6D1" FontSize="12" FontWeight="SemiBold" Margin="0,24,0,8"/>
                    <Button Content="الفواتير والمدفوعات" Tag="Billing" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button Content="الصيدلية والمخزون" Tag="Pharmacy" Click="Navigation_Click" Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="تسجيل الخروج" Click="Logout_Click" Style="{StaticResource SidebarDangerButtonStyle}"/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock Text="مركز العمليات" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                    <StackPanel DockPanel.Dock="Left" HorizontalAlignment="Left">
                        <TextBlock x:Name="UserText" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="متصل بالنظام" Foreground="{StaticResource SuccessBrush}" FontSize="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
