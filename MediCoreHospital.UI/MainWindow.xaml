<Window x:Class="MediCoreHospital.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediCore | نظام إدارة المستشفى"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Cairo, Segoe UI, Arial"
        Background="#F7F9FC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D1B3A" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MediCore" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="نظام إدارة المستشفى" Foreground="#CFE5FF" Margin="0,4,0,24"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="لوحة التحكم" Tag="Dashboard" Click="Navigation_Click" Margin="0,4" Padding="12" Background="#163B67" Foreground="White" BorderThickness="0"/>
                    <Button Content="المرضى" Tag="Patients" Click="Navigation_Click" Margin="0,4" Padding="12" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="الأطباء والأقسام" Tag="Clinical" Click="Navigation_Click" Margin="0,4" Padding="12" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="المواعيد" Tag="Appointments" Click="Navigation_Click" Margin="0,4" Padding="12" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="التنويم" Tag="Inpatient" Click="Navigation_Click" Margin="0,4" Padding="12" Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="الفواتير" Tag="Billing" Click="Navigation_Click" Margin="0,4" Padding="12" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="تسجيل الخروج" Click="Logout_Click" Padding="12" Background="#8B2635" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E5ECF4" BorderThickness="0,0,0,1" Padding="24">
                <DockPanel>
                    <TextBlock Text="نظام إدارة المستشفى" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="المستخدم: مدير النظام" Foreground="#64748B" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
