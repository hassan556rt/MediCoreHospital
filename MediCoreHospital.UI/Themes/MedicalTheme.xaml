<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NavyBrush" Color="#0B1F3A"/><SolidColorBrush x:Key="BlueBrush" Color="#1677C8"/><SolidColorBrush x:Key="TealBrush" Color="#10A6A1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F7FB"/><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="BorderBrush" Color="#DFE8F2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/><SolidColorBrush x:Key="SuccessBrush" Color="#159A68"/><SolidColorBrush x:Key="DangerBrush" Color="#C0394B"/>
    <Style TargetType="TextBox" x:Key="InputStyle"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Background" Value="#FAFCFF"/></Style>
    <Style TargetType="PasswordBox" x:Key="PasswordStyle"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Background" Value="#FAFCFF"/></Style>
    <Style TargetType="TextBlock" x:Key="FieldLabelStyle"><Setter Property="Foreground" Value="#334155"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style TargetType="Button" x:Key="PrimaryButtonStyle"><Setter Property="Height" Value="46"/><Setter Property="Background" Value="{StaticResource BlueBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="Button" x:Key="SidebarButtonStyle"><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E7F1FB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="Button" x:Key="SidebarDangerButtonStyle" BasedOn="{StaticResource SidebarButtonStyle}"><Setter Property="Background" Value="#8F3046"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Border" x:Key="CardStyle"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/></Style>
</ResourceDictionary>
