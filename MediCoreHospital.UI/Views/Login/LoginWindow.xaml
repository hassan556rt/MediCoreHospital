<Window x:Class="MediCoreHospital.UI.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediCore | تسجيل الدخول" Width="520" Height="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="{StaticResource SurfaceBrush}">
    <Border Margin="24" Padding="34" Background="{StaticResource CardBrush}" CornerRadius="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="76" Height="76" CornerRadius="22" Background="{StaticResource TealBrush}">
                    <TextBlock Text="MC" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="MediCore" FontSize="30" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="نظام إدارة المستشفى" FontSize="15" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}" Margin="0,0,0,22"/>
                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="UsernameTextBox" Style="{StaticResource InputStyle}"/>
                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,0"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}" KeyDown="PasswordBox_KeyDown"/>
                <CheckBox x:Name="RememberCheckBox" Content="تذكر بيانات الدخول" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0"/>
                <Button x:Name="LoginButton" Content="دخول النظام" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" Margin="0,24,0,0"/>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,14,0,0"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,14,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="بيئة تشغيل آمنة ومتكاملة للرعاية الصحية" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
