<UserControl x:Class="MediCoreHospital.UI.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F7F9FC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" Background="#0D1B3A" Padding="24" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="لوحة التحكم" Foreground="White" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="نظرة عامة على أداء المستشفى" Foreground="#CFE5FF" FontSize="14" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#163B67" CornerRadius="12" Padding="12,8">
                        <TextBlock Text="12:35 م" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#163B67" CornerRadius="12" Padding="12,8" Margin="12,0,0,0">
                        <TextBlock Text="17/09/2026" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,18">
            <Border Width="240" Height="140" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#EAF6FF">
                        <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1,284" FontSize="28" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="إجمالي المرضى" Foreground="#64748B" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Width="240" Height="140" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#E8FFF5">
                        <TextBlock Text="🩺" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="52" FontSize="28" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="الأطباء" Foreground="#64748B" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Width="240" Height="140" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#EAF7FF">
                        <TextBlock Text="📅" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="218" FontSize="28" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="مواعيد اليوم" Foreground="#64748B" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Width="240" Height="140" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#EAFBF3">
                        <TextBlock Text="🛏️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="86%" FontSize="28" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="نسبة إشغال الغرف" Foreground="#64748B" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Border>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="إيرادات المستشفى" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18" />
                    <Canvas Height="180" Width="680">
                        <Polyline Points="10,150 80,130 150,110 220,120 290,90 360,92 430,60 500,75 570,45 640,35" Stroke="#0F4C81" StrokeThickness="4" />
                        <Polyline Points="10,150 80,130 150,110 220,120 290,90 360,92 430,60 500,75 570,45 640,35" Stroke="#B7D8FF" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.22" />
                    </Canvas>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="JAN" Foreground="#64748B" Margin="0,0,12,0" />
                        <TextBlock Text="FEB" Foreground="#64748B" Margin="0,0,12,0" />
                        <TextBlock Text="MAR" Foreground="#64748B" Margin="0,0,12,0" />
                        <TextBlock Text="APR" Foreground="#64748B" Margin="0,0,12,0" />
                        <TextBlock Text="MAY" Foreground="#64748B" Margin="0,0,12,0" />
                        <TextBlock Text="JUN" Foreground="#64748B" Margin="0,0,12,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="الأقسام" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18" />

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الطوارئ" Foreground="#475569" Margin="0,0,0,4" />
                        <ProgressBar Height="10" Minimum="0" Maximum="100" Value="84" Foreground="#1EA7A1" Background="#E2E8F0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الأشعة" Foreground="#475569" Margin="0,0,0,4" />
                        <ProgressBar Height="10" Minimum="0" Maximum="100" Value="72" Foreground="#0F4C81" Background="#E2E8F0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="العمليات" Foreground="#475569" Margin="0,0,0,4" />
                        <ProgressBar Height="10" Minimum="0" Maximum="100" Value="58" Foreground="#F7B267" Background="#E2E8F0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="الداخلية" Foreground="#475569" Margin="0,0,0,4" />
                        <ProgressBar Height="10" Minimum="0" Maximum="100" Value="68" Foreground="#2FBF71" Background="#E2E8F0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="المواعيد القادمة" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />

                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                            <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="*" />
                            <DataGridTextColumn Header="القسم" Binding="{Binding Department}" Width="*" />
                            <DataGridTextColumn Header="الوقت" Binding="{Binding Time}" Width="140" />
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="التنبيهات" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14" />

                    <Border Background="#FFF7E8" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="تنبيه مخزون" Foreground="#A16207" FontWeight="Bold" />
                            <TextBlock Text="صيدلية الطوارئ بحاجة إلى إعادة التزويد اليوم." Foreground="#7C5A00" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#EAFBF3" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="تقرير مختبري" Foreground="#0F766E" FontWeight="Bold" />
                            <TextBlock Text="تقرير 4 مرضى جاهز للمراجعة الطبية." Foreground="#115E59" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FDECEC" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="فاتورة معلقة" Foreground="#B91C1C" FontWeight="Bold" />
                            <TextBlock Text="مبلغ 3,420 ر.س في انتظار التسوية." Foreground="#7F1D1D" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
