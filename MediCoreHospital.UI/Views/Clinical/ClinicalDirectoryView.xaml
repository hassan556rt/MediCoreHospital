<UserControl x:Class="MediCoreHospital.UI.Views.Clinical.ClinicalDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F7F9FC">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="الأطباء والأقسام" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="دليل الأطباء والتخصصات والأقسام الطبية" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="12,0" VerticalContentAlignment="Center" ToolTip="البحث باسم الطبيب أو التخصص"/><Button Grid.Column="1" Content="بحث وتحديث" Height="42" Width="130" Margin="12,0,0,0" Background="#0F4C81" Foreground="White" BorderThickness="0" Click="Refresh_Click"/></Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,18,0"><DataGrid ItemsSource="{Binding Doctors}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC"><DataGrid.Columns><DataGridTextColumn Header="الطبيب" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="التخصص" Binding="{Binding Specialty}" Width="*"/><DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" Width="*"/><DataGridTextColumn Header="رقم الترخيص" Binding="{Binding LicenseNumber}" Width="140"/><DataGridTextColumn Header="رسوم الكشف" Binding="{Binding ConsultationFee, StringFormat={}{0:N2}}" Width="120"/></DataGrid.Columns></DataGrid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="الأقسام النشطة" FontSize="21" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Departments}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F1F7FB" CornerRadius="10" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DepartmentName}" FontWeight="SemiBold" Foreground="#0F4C81"/><TextBlock Text="{Binding Description}" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
