<UserControl x:Class="MediCoreHospital.UI.Views.Pharmacy.PharmacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F7F9FC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="الصيدلية" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="إدارة مخزون الأدوية والوصفات الطبية" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="42" Padding="12,0" VerticalContentAlignment="Center" ToolTip="البحث باسم المريض أو الطبيب أو الدواء"/>
                <Button Grid.Column="1" Content="بحث وتحديث" Width="130" Height="42" Margin="12,0,0,0" Background="#0F4C81" Foreground="White" BorderThickness="0" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,18,0">
                <DataGrid ItemsSource="{Binding Prescriptions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="*"/>
                        <DataGridTextColumn Header="الدواء" Binding="{Binding MedicineName}" Width="*"/>
                        <DataGridTextColumn Header="الجرعة" Binding="{Binding Dosage}" Width="120"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding PrescriptionDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="الأدوية منخفضة المخزون" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding LowStockItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F1F7FB" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MedicineName}" FontWeight="SemiBold" Foreground="#0F4C81"/>
                                        <TextBlock Text="{Binding Category}" Foreground="#64748B" Margin="0,4,0,0"/>
                                        <TextBlock Text="المخزون: {Binding Quantity}   /   السعر: {Binding UnitPrice, StringFormat={}{0:N2}}" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        <TextBlock Text="تاريخ انتهاء الصلاحية: {Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Foreground="#B91C1C" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
