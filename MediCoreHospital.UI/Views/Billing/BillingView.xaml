<UserControl x:Class="MediCoreHospital.UI.Views.Billing.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F7F9FC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="الفواتير" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="مراجعة الفواتير المفتوحة والمستحقة" Foreground="#64748B" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="الفواتير المفتوحة" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Invoices.Count, StringFormat=الإجمالي: {0}}" Foreground="#0F4C81" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <Button Content="تحديث" Width="100" Height="38" Margin="18,0,0,0" Background="#0F4C81" Foreground="White" BorderThickness="0" Click="Refresh_Click"/>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Width="90" Height="4" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="140"/>
                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding IssueDate, StringFormat=dd/MM/yyyy}" Width="140"/>
                    <DataGridTextColumn Header="المبلغ الكلي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
