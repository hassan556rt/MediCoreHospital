<UserControl x:Class="MediCoreHospital.UI.Views.Patients.PatientsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="RightToLeft" Background="#F7F9FC">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="المرضى" FontSize="30" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="إدارة ملفات المرضى والبحث في السجل الطبي" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Height="42" FontSize="15" Padding="12,0" VerticalContentAlignment="Center" ToolTip="البحث بالاسم أو رقم الملف أو الهاتف"/><Button Grid.Column="1" Content="بحث" Width="100" Height="42" Margin="12,0,0,0" Background="#0F4C81" Foreground="White" BorderThickness="0" Click="Search_Click"/><Button Grid.Column="2" Content="تحديث" Width="100" Height="42" Margin="12,0,0,0" Background="#1EA7A1" Foreground="White" BorderThickness="0" Click="Refresh_Click"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,18,0"><DataGrid ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC"><DataGrid.Columns><DataGridTextColumn Header="رقم الملف" Binding="{Binding MedicalRecordNumber}" Width="140"/><DataGridTextColumn Header="اسم المريض" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="الجنس" Binding="{Binding Gender}" Width="100"/><DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="140"/><DataGridTextColumn Header="تاريخ الميلاد" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="130"/></DataGrid.Columns></DataGrid></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=}" Visibility="Collapsed"/><TextBlock Text="بيانات المريض" FontSize="21" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/><TextBlock Text="الاسم الأول"/><TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="اسم العائلة"/><TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="رقم الملف الطبي"/><TextBox Text="{Binding MedicalRecordNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="رقم الهوية"/><TextBox Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="الهاتف"/><TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="البريد الإلكتروني"/><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="تاريخ الميلاد"/><DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="الجنس"/><ComboBox SelectedValue="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="0,6,0,12" Height="38"><ComboBoxItem Content="ذكر" Tag="ذكر"/><ComboBoxItem Content="أنثى" Tag="أنثى"/></ComboBox><TextBlock Text="فصيلة الدم"/><TextBox Text="{Binding BloodType, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="38"/><TextBlock Text="العنوان"/><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,16" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/><StackPanel Orientation="Horizontal"><Button Content="مريض جديد" Width="105" Height="42" Margin="0,0,8,0" Click="New_Click"/><Button Content="حفظ البيانات" Width="105" Height="42" Background="#1EA7A1" Foreground="White" BorderThickness="0" Click="Save_Click"/><Button Content="حذف" Width="75" Height="42" Margin="8,0,0,0" Background="#B91C1C" Foreground="White" BorderThickness="0" Click="Delete_Click"/></StackPanel><ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Height="3" Margin="0,10,0,0"/><TextBlock Text="{Binding SuccessMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
    </Grid>
  </Grid>
</UserControl>
