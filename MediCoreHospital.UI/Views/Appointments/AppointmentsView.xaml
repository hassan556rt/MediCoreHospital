<UserControl x:Class="MediCoreHospital.UI.Views.Appointments.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F7F9FC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="المواعيد" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="إدارة مواعيد المرضى ومتابعة جدول الأطباء" Foreground="#64748B" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تاريخ المواعيد" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,12,0" />
                <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="38" />
                <Button Content="تحديث" Width="100" Height="38" Margin="12,0,0,0"
                        Background="#0F4C81" Foreground="White" BorderThickness="0" Click="Refresh_Click" />
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Width="90" Height="4" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="جدول المواعيد" FontSize="21" FontWeight="Bold"
                           Foreground="#0F172A" Margin="12,8,12,14" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Appointments}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          AlternatingRowBackground="#F8FAFC" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المريض" Binding="{Binding PatientName}" Width="*" />
                        <DataGridTextColumn Header="الطبيب" Binding="{Binding DoctorName}" Width="*" />
                        <DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" Width="*" />
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding AppointmentDate, StringFormat=dd/MM/yyyy}" Width="130" />
                        <DataGridTextColumn Header="من" Binding="{Binding StartTime, StringFormat=hh\:mm}" Width="90" />
                        <DataGridTextColumn Header="إلى" Binding="{Binding EndTime, StringFormat=hh\:mm}" Width="90" />
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                           TextWrapping="Wrap" Margin="12,12,12,4" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
